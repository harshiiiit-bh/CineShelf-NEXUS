# GEMINI_API_KEY: Optional for AI-assisted natural language search or insights.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LIVEKIT CREDENTIALS: Optional for real-time spatial voice chat in Nexus Social 3D Cinema.
# When omitted, spatial proximity calculation and LiveKit token handshakes operate in simulated fallback mode.
LIVEKIT_WS_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
